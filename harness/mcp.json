{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "agentsview": {
      "type": "stdio",
      "command": "agentsview",
      "args": ["mcp"]
    },
    "hindsight": {
      "type": "http",
      "url": "http://localhost:8888/mcp/ivr/"
    }
  }
}
